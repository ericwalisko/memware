{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "nohup sh -c 'memware sync --harness claude-code; memware backup --if-stale 20 --quiet; memware derive --apply --auto --if-stale 24 --quiet' >/dev/null 2>&1 & true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "memware notice --from-hook 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "nohup memware sync --harness claude-code --from-hook >/dev/null 2>&1 &",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "nohup memware backup --if-stale 20 --quiet >/dev/null 2>&1 &",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "memware sync --harness claude-code --from-hook",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "memware context --from-hook -k 6",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
